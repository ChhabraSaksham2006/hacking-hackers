# Track metadata, reports, configuration files, and processed temporal state parquets
!data/metadata/*.csv
!data/metadata/*.yaml
!data/episodes/*.csv
!data/benchmark_splits/*.parquet
!configs/*.yaml
!reports/**/*.csv
!reports/**/*.md
!reports/**/*.json
!data/processed/temporal_states/*.parquet
