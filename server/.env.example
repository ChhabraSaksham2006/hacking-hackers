# ──────────────────────────────────────────────────
# Aegis Vantage — Backend Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aegis_vantage

# JWT
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ML Service (optional — mock results used when not set)
ML_SERVICE_URL=

# Object Storage (optional — local uploads/ used in dev when not set)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Redis (optional — required for BullMQ job queues)
REDIS_URL=
